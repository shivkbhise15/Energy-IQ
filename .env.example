NODE_ENV=development
DATABASE_URL=postgresql://energyiq:energyiq@postgres:5432/energyiq?schema=public
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:5173
API_GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://auth-service:4101
ORGANIZATION_SERVICE_URL=http://organization-service:4102
DEVICE_SERVICE_URL=http://device-service:4103
ANALYTICS_SERVICE_URL=http://analytics-service:4104
FORECAST_SERVICE_URL=http://forecast-service:4105
AI_SERVICE_URL=http://ai-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:4106
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=alerts@energyiq.local
